{
  "name": "completamenteapp",
  "version": "1.0.0",
  "description": "Aplicativo de bem-estar mental e saúde completa",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
