{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@2.0.0"
    }
  },
  "build": {
    "env": {
      "OPENAI_MODEL": "gpt-4o-mini",
      "GEMINI_MODEL": "gemini-1.5-flash",
      "QWEN_MODEL": "qwen-plus",
      "GROQ_MODEL": "llama-3.1-8b-instant",
      "FIREBASE_API_KEY": "AIzaSyCCi1hrmt4OQFlgrQThbB6-n54v5WwlJoY",
      "FIREBASE_AUTH_DOMAIN": "completamenteapp.firebaseapp.com",
      "FIREBASE_DATABASE_URL": "https://completamenteapp-default-rtdb.firebaseio.com",
      "FIREBASE_PROJECT_ID": "completamenteapp",
      "FIREBASE_STORAGE_BUCKET": "completamenteapp.firebasestorage.app",
      "FIREBASE_MESSAGING_SENDER_ID": "343038230333",
      "FIREBASE_APP_ID": "1:343038230333:web:2338b20d2e706743b40f54"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
